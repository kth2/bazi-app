  "rules": [
    {
      "id": "overall_shen_qiang",
      "category": "整体命局",
      "title": "身强之命",
      "weight": 6,
      "minMatchRatio": 1.0,
      "conditions": [
        {
          "type": "verdict",
          "value": "身强",
          "required": true
        }
      ],
      "interpretation": "日主得令得势，同党力量过半，属身强格局。身强者能任财官，喜财星、官杀、食伤克泄耗，忌印比再助身。行运宜走财官食伤之地，人生主动进取方能发挥命局潜力。",
      "source": "渊海子平",
      "tier": 1,
      "layer": "原局"
    },
    {
      "id": "overall_shen_ruo",
      "category": "整体命局",
      "title": "身弱之命",
      "weight": 6,
      "minMatchRatio": 1.0,
      "conditions": [
        {
          "type": "verdict",
          "value": "身弱",
          "required": true
        }
      ],
      "interpretation": "日主失令失势，同党力量不足，属身弱格局。身弱者不胜财官，喜印星生身、比劫帮身，忌财官食伤再克泄。宜稳中求进，善借他人之力，贵人相助尤为关键。",
      "source": "渊海子平",
      "tier": 1,
      "layer": "原局"
    },
    {
